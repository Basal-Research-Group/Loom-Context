      "functions": "camelCase",
      "methods": "camelCase",
      "constants": "UPPER_SNAKE",
      "interfaces": "PascalCase",
      "types": "PascalCase"
    },
    "comment_style": "//",
    "import_pattern": "^import\\s+(?:\\{[^}]+\\}|\\w+|\\*)\\s+from\\s+['\"]([^'\"]+)['\"]",
    "class_pattern": "(?:export\\s+)?(?:abstract\\s+)?(?:class|interface|type)\\s+(\\w+)",
    "function_pattern": "(?:export\\s+)?(?:async\\s+)?function\\s+(\\w+)",
    "constant_pattern": "(?:export\\s+)?const\\s+([A-Z][A-Z_0-9]+)\\s*=",
    "frameworks": {
      "nextjs": {
        "markers": [
          "next.config.js",
          "next.config.mjs",
          "next.config.ts"
        ],
        "src_roots": [
          "src",
          "app",
          "pages"
        ],
        "dir_exclusions": [
          ".next",
          "out"
        ]
      },
      "angular": {
        "markers": [
          "angular.json",
          "angular.cli.json"
