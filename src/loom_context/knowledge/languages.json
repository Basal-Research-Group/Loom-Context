{
  "python": {
    "name": "Python",
    "extensions": [
      ".py",
      ".pyi",
      ".pyw"
    ],
    "markers": [
      "pyproject.toml",
      "setup.py",
      "setup.cfg",
      "requirements.txt",
      "Pipfile"
    ],
    "project_type": "python",
    "package_managers": [
      {
        "file": "pyproject.toml",
        "lock": "poetry.lock",
        "tool": "poetry"
      },
      {
        "file": "pyproject.toml",
        "lock": "uv.lock",
        "tool": "uv"
      },
      {
        "file": "pyproject.toml",
        "lock": null,
        "tool": "pip"
      },
      {
        "file": "requirements.txt",
        "lock": null,
        "tool": "pip"
      },
      {
        "file": "Pipfile",
        "lock": "Pipfile.lock",
        "tool": "pipenv"
      }
    ],
    "naming": {
      "files": "snake_case",
      "classes": "PascalCase",
      "functions": "snake_case",
      "methods": "snake_case",
      "constants": "UPPER_SNAKE",
      "modules": "snake_case"
    },
    "comment_style": "#",
    "import_pattern": "^(?:from|import)\\s+([\\w.]+)",
    "class_pattern": "class\\s+(\\w+)",
    "function_pattern": "def\\s+(\\w+)",
    "constant_pattern": "^([A-Z][A-Z_0-9]+)\\s*(?::[\\w\\[\\], ]+\\s*)?=",
    "frameworks": {
      "django": {
        "markers": [
          "manage.py",
          "django",
          "settings.py"
        ],
        "src_roots": [
          ".",
          "apps"
        ],
        "dir_exclusions": [
          "staticfiles",
          "media"
        ]
      },
      "flask": {
        "markers": [
          "flask"
        ],
        "src_roots": [
          ".",
          "app"
        ],
        "dir_exclusions": [
          "instance"
        ]
      },
      "fastapi": {
        "markers": [
          "fastapi"
        ],
        "src_roots": [
          ".",
          "app"
        ],
        "dir_exclusions": []
      }
    }
  },
  "typescript": {
    "name": "TypeScript",
