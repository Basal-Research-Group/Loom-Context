{
  "services": {
    "redis": {
      "name": "Redis",
      "category": "cache",
      "default_port": 6379,
      "install_cmd_mac": "brew install redis",
      "install_cmd_linux": "sudo apt install redis-server",
      "start_cmd_mac": "brew services start redis",
      "start_cmd_linux": "sudo systemctl start redis",
      "stop_cmd_mac": "brew services stop redis",
      "stop_cmd_linux": "sudo systemctl stop redis",
      "status_cmd": "redis-cli ping",
      "docker_cmd": "docker run -d --name redis -p 6379:6379 redis:alpine",
      "config_env": "REDIS_URL",
      "config_hint": "redis://localhost:6379",
      "binaries": ["redis-server", "redis-cli"]
    },
    "postgresql": {
      "name": "PostgreSQL",
      "category": "database",
      "default_port": 5432,
      "install_cmd_mac": "brew install postgresql@16",
      "install_cmd_linux": "sudo apt install postgresql",
      "start_cmd_mac": "brew services start postgresql@16",
      "start_cmd_linux": "sudo systemctl start postgresql",
      "stop_cmd_mac": "brew services stop postgresql@16",
      "stop_cmd_linux": "sudo systemctl stop postgresql",
      "status_cmd": "pg_isready",
      "docker_cmd": "docker run -d --name postgres -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:16-alpine",
      "config_env": "DATABASE_URL",
      "config_hint": "postgresql://user:pass@localhost:5432/dbname",
      "binaries": ["psql", "pg_isready"]
    },
    "mysql": {
      "name": "MySQL",
      "category": "database",
      "default_port": 3306,
      "install_cmd_mac": "brew install mysql",
      "install_cmd_linux": "sudo apt install mysql-server",
      "start_cmd_mac": "brew services start mysql",
      "start_cmd_linux": "sudo systemctl start mysql",
      "stop_cmd_mac": "brew services stop mysql",
      "stop_cmd_linux": "sudo systemctl stop mysql",
      "status_cmd": "mysqladmin ping",
      "docker_cmd": "docker run -d --name mysql -p 3306:3306 -e MYSQL_ROOT_PASSWORD=root mysql:8",
      "config_env": "MYSQL_URL",
      "config_hint": "mysql://user:pass@localhost:3306/dbname",
      "binaries": ["mysql", "mysqld"]
    },
    "mongodb": {
      "name": "MongoDB",
      "category": "database",
      "default_port": 27017,
      "install_cmd_mac": "brew install mongodb-community",
      "install_cmd_linux": "sudo apt install mongodb",
      "start_cmd_mac": "brew services start mongodb-community",
      "start_cmd_linux": "sudo systemctl start mongod",
      "docker_cmd": "docker run -d --name mongo -p 27017:27017 mongo:7",
      "config_env": "MONGODB_URI",
      "config_hint": "mongodb://localhost:27017/dbname",
      "binaries": ["mongod", "mongosh"]
    },
    "elasticsearch": {
      "name": "Elasticsearch",
      "category": "search",
      "default_port": 9200,
      "docker_cmd": "docker run -d --name es -p 9200:9200 -e discovery.type=single-node elasticsearch:8.12.0",
      "config_env": "ELASTICSEARCH_URL",
      "config_hint": "http://localhost:9200",
      "binaries": ["elasticsearch"]
    },
    "rabbitmq": {
      "name": "RabbitMQ",
      "category": "queue",
      "default_port": 5672,
      "install_cmd_mac": "brew install rabbitmq",
      "install_cmd_linux": "sudo apt install rabbitmq-server",
      "start_cmd_mac": "brew services start rabbitmq",
      "start_cmd_linux": "sudo systemctl start rabbitmq-server",
      "docker_cmd": "docker run -d --name rabbitmq -p 5672:5672 -p 15672:15672 rabbitmq:3-management",
      "config_env": "AMQP_URL",
      "config_hint": "amqp://localhost:5672",
      "binaries": ["rabbitmq-server"]
    },
    "meilisearch": {
      "name": "Meilisearch",
      "category": "search",
      "default_port": 7700,
      "install_cmd_mac": "brew install meilisearch",
      "docker_cmd": "docker run -d --name meili -p 7700:7700 getmeili/meilisearch:latest",
      "config_env": "MEILI_URL",
      "config_hint": "http://localhost:7700",
      "binaries": ["meilisearch"]
    },
    "kafka": {
      "name": "Kafka",
      "category": "queue",
      "default_port": 9092,
      "docker_cmd": "docker compose up -d",
      "config_env": "KAFKA_BROKERS",
      "config_hint": "localhost:9092",
      "binaries": []
    },
    "minio": {
      "name": "MinIO",
      "category": "storage",
      "default_port": 9000,
      "install_cmd_mac": "brew install minio",
      "docker_cmd": "docker run -d --name minio -p 9000:9000 -p 9001:9001 minio/minio server /data --console-address :9001",
      "config_env": "MINIO_ENDPOINT",
      "config_hint": "http://localhost:9000",
      "binaries": ["minio"]
    },
    "sqlite": {
      "name": "SQLite",
      "category": "database",
      "default_port": 0,
      "binaries": ["sqlite3"]
    },
    "memcached": {
      "name": "Memcached",
      "category": "cache",
      "default_port": 11211,
      "install_cmd_mac": "brew install memcached",
      "install_cmd_linux": "sudo apt install memcached",
      "start_cmd_mac": "brew services start memcached",
      "start_cmd_linux": "sudo systemctl start memcached",
      "docker_cmd": "docker run -d --name memcached -p 11211:11211 memcached:alpine",
      "config_env": "MEMCACHED_URL",
      "config_hint": "localhost:11211",
      "binaries": ["memcached"]
    },
    "clickhouse": {
      "name": "ClickHouse",
      "category": "database",
      "default_port": 8123,
      "docker_cmd": "docker run -d --name clickhouse -p 8123:8123 -p 9000:9000 clickhouse/clickhouse-server",
      "config_env": "CLICKHOUSE_URL",
      "config_hint": "http://localhost:8123",
      "binaries": ["clickhouse-client"]
    },
    "neo4j": {
      "name": "Neo4j",
      "category": "database",
      "default_port": 7687,
      "docker_cmd": "docker run -d --name neo4j -p 7474:7474 -p 7687:7687 -e NEO4J_AUTH=neo4j/password neo4j:5",
      "config_env": "NEO4J_URI",
      "config_hint": "bolt://localhost:7687",
      "binaries": ["neo4j"]
    }
  },
  "package_mapping": {
    "pg": "postgresql",
    "@prisma/client": "postgresql",
    "prisma": "postgresql",
    "sqlalchemy": "postgresql",
    "alembic": "postgresql",
    "psycopg2": "postgresql",
    "asyncpg": "postgresql",
    "postgrex": "postgresql",
    "pgx": "postgresql",
    "diesel": "postgresql",
    "sqlx": "postgresql",
    "activerecord": "postgresql",
    "sequel": "postgresql",
    "mysql2": "mysql",
    "mongoose": "mongodb",
    "pymongo": "mongodb",
    "motor": "mongodb",
    "mongodb": "mongodb",
    "sqlite3": "sqlite",
    "better-sqlite3": "sqlite",
    "expo-sqlite": "sqlite",
    "redis": "redis",
    "ioredis": "redis",
    "bull": "redis",
    "bullmq": "redis",
    "celery": "redis",
    "redis-py": "redis",
    "sidekiq": "redis",
    "resque": "redis",
    "elasticsearch": "elasticsearch",
    "@elastic/elasticsearch": "elasticsearch",
    "meilisearch": "meilisearch",
    "amqplib": "rabbitmq",
    "kafkajs": "kafka",
    "kafka-clients": "kafka",
    "minio": "minio",
    "dalli": "memcached",
    "memcached": "memcached",
    "neo4j": "neo4j",
    "py2neo": "neo4j",
    "clickhouse-driver": "clickhouse"
  }
}
